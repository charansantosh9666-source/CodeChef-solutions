#include <bits/stdc++.h>
using namespace std;
void solve() {
    int n;
    if (!(cin >> n)) return;
    
    vector<int> p(n + 1);
    vector<int> pos(n + 1);
    for (int i = 1; i <= n; ++i) {
        cin >> p[i];
        pos[p[i]] = i;
    }
    
    int k = (n + 1) / 2;
    
    vector<int> min_pos(k + 1), max_pos(k + 1);
    int cur_min = n + 1, cur_max = 0;
    for (int i = 1; i <= k; ++i) {
        cur_min = min(cur_min, pos[i]);
        cur_max = max(cur_max, pos[i]);
        min_pos[i] = cur_min;
        max_pos[i] = cur_max;
    }
    
    vector<int> A(k + 1), B(k + 1);
    for (int i = 1; i <= k; ++i) {
        A[i] = max(1, max_pos[i] - 2 * i + 2);
        B[i] = min(min_pos[i], n - 2 * i + 2);
        if (A[i] > B[i]) {
            cout << -1 << "\n";
            return;
        }
    }
    
    vector<int> X(k + 1), Y(k + 1);
    X[k] = A[k];
    Y[k] = B[k];
    
    for (int i = k - 1; i >= 1; --i) {
        X[i] = max(A[i], X[i + 1]);
        Y[i] = min(B[i], Y[i + 1] + 2);
        if (X[i] > Y[i]) {
            cout << -1 << "\n";
            return;
        }
    }
    
    vector<int> L(k + 1);
    L[1] = X[1];
    for (int i = 2; i <= k; ++i) {
        L[i] = max(X[i], L[i - 1] - 2);
    }
    
    for (int i = 1; i <= k; ++i) {
        int R = L[i] + 2 * i - 2;
        cout << L[i] << " " << R << "\n";
    }
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int t;
    if (cin >> t) {
        while (t--) {
            solve();
        }
    }
    return 0;
}