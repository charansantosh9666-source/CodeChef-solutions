#include <bits/stdc++.h>
using namespace std;
long long ans(const vector<int>& a, int n, long long k) {
    long long sum = 0;
    long long target = 2 * k;

    // Iterate only through even indices
    for (int i = 0; i < n; i += 2) {
        // Consider only elements strictly greater than 2K
        if (a[i] > target) {
            sum += a[i];
        }
    }
    return sum;
}
int main() {
	// your code goes here
	int n,k;
	cin>>n>>k;
	vector<int>a;
	for(int i=0;i<n;i++){
	    int b;
	    cin>>b;
	    a.push_back(b);
	}
	int b;
	b=ans(a,n,k);
	cout<<b;
	return 0;
}
