#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        vector<int> P(N);
        for (int &x : P)
            cin >> x;
        for (int i = 1; i < N; i++) {
            int j = i;

            while (j > 0 &&
                   P[j] < P[j - 1] &&
                   P[j - 1] - P[j] > 1) {
                swap(P[j], P[j - 1]);
                j--;
            }
        }

        for (int i = 0; i < N; i++) {
            cout << P[i] << (i + 1 == N ? '\n' : ' ');
        }
    }

    return 0;

}
