#include <bits/stdc++.h>
using namespace std;

void solve() {
    int N, M, K;
    cin >> N >> M >> K;
    
    vector<bool> occupied(N + 1, false);
    
    for (int i = 0; i < M; i++) {
        int seat;
        cin >> seat;
        occupied[seat] = true;
    }
    
    for (int i = 0; i < K; i++) {
        for (int seat = 1; seat <= N; seat++) {
            if (!occupied[seat]) {
                cout << seat << (i == K - 1 ? "" : " ");
                occupied[seat] = true; 
                break;
            }
        }
    }
    cout << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int T;
    cin >> T;
    while (T--) {
        solve();
    }
    
    return 0;
}
