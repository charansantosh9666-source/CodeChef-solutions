#include <bits/stdc++.h>
using namespace std;
void solve(){
    int n;
    cin>>n;
    vector<long long>a(n);
    for(int i=0;i<n;++i){
        cin>>a[i];
    }
    long long ops=0;
    long long d1=0;
    long long d2=0;
    
    for(int i=0;i<n;++i){
        if(i%2==0){
            a[i] +=d1;
            
        }else{
            a[i]+=d2;
            
        }
        if(a[i]!=0){
            long long v=-a[i];
            ops+=abs(v);
            if(i%2==0){
                d1+=v;
                d2-=v;
                
            }else{
                d2+=v;
                d1-=v;
            }
            a[i]=0;
        }
    }
    cout<<ops<<"\n";
}

int main() {
	// your code goes here
	int t;
	cin>>t;
	while (t--){
	    solve();
	}
	return 0;
}
