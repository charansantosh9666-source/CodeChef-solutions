#include <bits/stdc++.h>
using namespace std;


void solve() {
    int n;
    cin >> n;
    vector<long long> a(n);
    set<long long> present;
    
    for (int i = 0; i < n; ++i) {
        cin >> a[i];
        present.insert(a[i]);
    }
    
    long long mex = 0;
    while (present.count(mex)) {
        mex++;
    }
    
    long long total_moves = 0;
    for (int i = 0; i < n; ++i) {
        if (a[i] > mex) {
            total_moves += (a[i] - mex - 1);
        } else if (a[i] < mex) {
            total_moves += a[i];
        }
    }
    
    total_moves -= (mex * (mex - 1)) / 2;
    
    if (total_moves % 2 == 1) {
        cout << "Alice\n";
    } else {
        cout << "Bob\n";
    }
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    
    return 0;
}