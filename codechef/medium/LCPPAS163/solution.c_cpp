#include <iostream>
using namespace std;

int main() {
	// your code goes here
	int n;
	cin>>n;
	int arr[n];
	for(int i=0;i<n;i++){
	    cin>>arr[i];
	}
	int Max=0;
	int a=0;
	for(int j=0;j<n;j++){
	    if(arr[j]!=0){
	        a++;
	    }else{
	        
	        Max=max(Max,a);
	        a=0;
	    }
	}
	cout<<Max;
	return 0;
}
