#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n;
    cin >> n;
    vector<int> a(n);
    for (int i = 0; i < n; ++i) {
        cin >> a[i];
    }

    if (n == 1) {
        cout << 1 << "\n";
        return;
    }

   
    vector<vector<int>> dp(n, vector<int>(2, -1e9));
    if (a[0] == 1) {
        dp[0][0] = 0;
    }
    dp[0][1] = 1;

    for (int i = 1; i < n; ++i) {
        if (a[i] == 1) {
            dp[i][0] = max(dp[i][0], dp[i - 1][1]);
        } else if (a[i] == 2) {
            dp[i][0] = max(dp[i][0], dp[i - 1][1]);
        }

        if (a[i - 1] == 1) {
            dp[i][1] = max(dp[i][1], dp[i - 1][0] + 1);
        } else if (a[i - 1] == 2) {
            dp[i][1] = max(dp[i][1], dp[i - 1][0] + 1);
        }
        
        dp[i][1] = max(dp[i][1], dp[i - 1][1] + 1);
    }

    cout << max(dp[n - 1][0], dp[n - 1][1]) << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}