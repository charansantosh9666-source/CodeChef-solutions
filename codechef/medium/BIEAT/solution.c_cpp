#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    if (!(cin >> n)) return 0;

    vector<long long> a(n);
    for (int i = 0; i < n; ++i) {
        cin >> a[i];
    }

    int m;
    cin >> m;

    for (int i = 0; i < n; ++i) {
        // Shift right by M bits to remove the M least significant bits
        long long result = a[i] >> m;
        cout << result << (i == n - 1 ? "" : " ");
    }
    cout << "\n";

    return 0;
}
