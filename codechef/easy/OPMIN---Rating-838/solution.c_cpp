class Solution {
public:
    int countNonMinimum(vector<int>& nums) {
        // write your code here 
        int Min=INT_MAX;
        int n=nums.size(),c=0;
        for(int i=0;i<n;i++){
            Min=min(Min,nums[i]);
        }
        for(int j=0;j<n;j++){
            if(nums[j]>Min){
                c++;
            }
        }
        return c;
    }
};
