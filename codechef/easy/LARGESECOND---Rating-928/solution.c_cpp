#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin>>t;
    while(t--){
        int n,FMax=0,SMax=0;
        cin>>n;
        int a[n];
        for(int i=0;i<n;i++){
            cin>>a[i];
        }
        // your code goes here
        FMax=a[0];
        for(int i=1;i<n;i++){
            if(FMax<a[i]){
                SMax=FMax;
                FMax=max(FMax,a[i]);
            }else if(SMax<a[i] && a[i]!=FMax){
                SMax=max(SMax,a[i]);
            }
        }
        cout<<FMax+SMax<<endl;
    }
}
